# Local development only. These are disposable credentials, not real secrets.
POSTGRES_USER=splitmate
POSTGRES_PASSWORD=splitmate_local_only
POSTGRES_DB=splitmate
DATABASE_URL=postgresql://splitmate:splitmate_local_only@localhost:5433/splitmate?schema=public
PORT=3001
WEB_ORIGIN=http://localhost:5173
# false only for local HTTP. HTTPS deployments require true.
COOKIE_SECURE=false
# Docker backend overrides DATABASE_URL with the internal db hostname.

# Optional direct migration URL; leave unset locally to use DATABASE_URL.
# DIRECT_URL=postgresql://splitmate:splitmate_local_only@localhost:5433/splitmate?schema=public
# Local API must not trust arbitrary proxy headers. Render explicitly sets 1.
TRUST_PROXY=0

# Cloud settings belong in ignored .local/neon.env, never in this local .env.
# DATABASE_URL=postgresql://ROLE:PASSWORD@ep-EXAMPLE-pooler.eu-west-2.aws.neon.tech/DATABASE?sslmode=require
# DIRECT_URL=postgresql://ROLE:PASSWORD@ep-EXAMPLE.eu-west-2.aws.neon.tech/DATABASE?sslmode=require
# Legacy DIRECT_DATABASE_URL remains supported; do not set conflicting aliases.

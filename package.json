{
  "name": "splitmate",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @splitmate/backend\" \"npm run dev -w @splitmate/frontend\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && npm run typecheck:tooling",
    "test": "npm run test -w @splitmate/backend",
    "test:integration": "npm run test:integration -w @splitmate/backend",
    "db:generate": "npm run db:generate -w @splitmate/backend",
    "db:migrate": "npm run db:migrate -w @splitmate/backend",
    "db:deploy": "npm run db:deploy -w @splitmate/backend",
    "lint": "eslint . --max-warnings 0",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json",
    "test:e2e": "playwright test",
    "check:repo": "node scripts/check-repository.mjs",
    "start": "npm run start -w @splitmate/backend",
    "start:render": "npm run db:deploy && npm start",
    "build:render": "npm run db:generate && npm run build",
    "test:production": "playwright test --config playwright.production.config.ts",
    "check:bundle": "node scripts/check-browser-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  }
}

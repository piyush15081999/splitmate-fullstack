{
  "name": "@splitmate/backend", "version": "0.1.0", "private": true, "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts", "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js", "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"tests/*.integration.test.ts\"", "test:integration": "vitest run integration.test.ts", "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev", "db:deploy": "prisma migrate deploy"
  },
  "dependencies": { "@prisma/client": "7.10.1", "@prisma/adapter-pg": "7.10.1", "pg": "^8.16.3", "dotenv": "^16.6.1", "express": "^5.1.0" },
  "devDependencies": {
    "@types/express": "^5.0.3", "@types/node": "^22.18.0", "@types/supertest": "^6.0.3",
    "prisma": "7.10.1", "supertest": "^7.1.4", "tsx": "^4.20.5", "typescript": "^5.9.2", "vitest": "^5.0.4"
  }
}

# Checklist only. Enter real values privately in Render, never commit them.
NODE_ENV=production
HOST=0.0.0.0
COOKIE_SECURE=true
TRUST_PROXY=1
# Replace with the exact assigned HTTPS origin, with no trailing slash.
WEB_ORIGIN=https://your-service.onrender.com
# Paste the Neon pooled URL with sslmode=require from its Connect dialog.
DATABASE_URL=
# Paste the direct (non-pooler) URL with sslmode=require, same empty cloud database.
DIRECT_DATABASE_URL=
# Render supplies PORT. Node version is pinned in render.yaml.
# No SESSION_SECRET: existing opaque session tokens are hashed and stored in PostgreSQL.
# Never prefix any database URL or secret with VITE_. No paid resources or seed runs.

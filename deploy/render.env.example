# Enter real values privately in Render. Never copy local .env to cloud.
NODE_VERSION=22.23.3
NODE_ENV=production
HOST=0.0.0.0
COOKIE_SECURE=true
TRUST_PROXY=1
# Use the exact assigned HTTPS origin, with no path or trailing slash.
WEB_ORIGIN=https://your-assigned-service.onrender.com
# The pooled Neon URL, including sslmode=require, stays server-side.
DATABASE_URL=
# Do not set DIRECT_URL or legacy DIRECT_DATABASE_URL on the web service.
# Prisma generation needs no URL; migrations are a separately approved operation.
# Render supplies PORT. No SESSION_SECRET or VITE_ database settings are needed.
